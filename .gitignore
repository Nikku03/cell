# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# Luthey-Schulten input data (the upstream repo is ~1.8 MB binary; re-stage
# it rather than redistribute - see memory_bank/data/STAGING.md). Narrowly
# scoped - do NOT use a bare `data/` pattern because that would also ignore
# memory_bank/data/*.csv (the small derived reference tables we DO commit).
cell_sim/data/Minimal_Cell_ComplexFormation/

# Outputs and caches
outputs/*.csv
outputs/*.png
outputs/*.tmp
outputs/.wt_*.pkl
*.log
*.tmp

# Secrets — never commit any of these
.env
.env.*
*.pem
*.key
*credentials*
*secret*
*token*
.github_token
gh_token.txt

# IDE
.vscode/
.idea/
.DS_Store

# Jupyter
.ipynb_checkpoints/

# memory_bank auto-generated indexes (rebuilt by check.py)
memory_bank/index/*.sqlite
memory_bank/index/*.faiss
memory_bank/index/concept_graph.json

# Local patch backups (not for the remote)
patches/

# Rust build artifacts (cell_sim_rust)
cell_sim_rust/target/
cell_sim_rust/Cargo.lock

# Feature cache — contains per-gene pretrained-model embeddings, usually
# large parquet files. Only the manifest (for integrity tracking) and
# the .gitkeep (so the empty cache dir survives) are tracked.
cell_sim/features/cache/*
!cell_sim/features/cache/manifest.json
!cell_sim/features/cache/.gitkeep
figures/output/
outputs/synthlet/.wt_*.pkl
data/external_data/feba/
data/external_data/transformer_inputs/

# co-expression compendium (PRECISE) - large matrix re-fetched via script
data/external_data/coexpression/log_tpm.csv
data/external_data/promoter_mpra/rlp5Min_SplitVariants.txt
data/external_data/promoter_mpra/revLP5_Min_MOPS_glu_expression.txt
outputs/orphan/cell_app_data.json
outputs/orphan/ecoli_esm.npz
outputs/orphan/cell_map_data.json

# large human GEM (re-fetchable via URL in colab/target_intel_human.py)
data/external_data/human/Human-GEM.xml
data/external_data/human/human_gem.txt
data/external_data/human/CRISPRGeneEffect.csv
data/external_data/human/signor.tsv
data/external_data/human/complexportal.tsv
data/external_data/human/cellphonedb.csv
data/external_data/human/dgidb.tsv
data/external_data/human/uniprot_acc_ptm.tsv
data/external_data/human/gnomad_constraint.txt.bgz

data/external_data/human/cCREs.bed
data/external_data/human/refGene.txt.gz

data/external_data/human/string_physical.txt.gz
data/external_data/human/string_aliases.txt.gz

data/external_data/human/uniprot_localization.tsv

data/external_data/human/gene_info.gz
data/external_data/human/hiv_interactions
data/external_data/human/hiv_interactions.gz

