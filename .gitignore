# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# Luthey-Schulten input data (the upstream repo is ~1.8 MB binary; re-stage
# it rather than redistribute - see memory_bank/data/STAGING.md). Narrowly
# scoped - do NOT use a bare `data/` pattern because that would also ignore
# memory_bank/data/*.csv (the small derived reference tables we DO commit).
cell_sim/data/Minimal_Cell_ComplexFormation/

# Outputs and caches
outputs/*.csv
outputs/*.png
outputs/*.tmp
outputs/.wt_*.pkl
*.log
*.tmp

# Secrets — never commit any of these
.env
.env.*
*.pem
*.key
*credentials*
*secret*
*token*
.github_token
gh_token.txt

# IDE
.vscode/
.idea/
.DS_Store

# Jupyter
.ipynb_checkpoints/

# memory_bank auto-generated indexes (rebuilt by check.py)
memory_bank/index/*.sqlite
memory_bank/index/*.faiss
memory_bank/index/concept_graph.json

# Local patch backups (not for the remote)
patches/

# Rust build artifacts (cell_sim_rust)
cell_sim_rust/target/
cell_sim_rust/Cargo.lock

# Feature cache — contains per-gene pretrained-model embeddings, usually
# large parquet files. Only the manifest (for integrity tracking) and
# the .gitkeep (so the empty cache dir survives) are tracked.
cell_sim/features/cache/*
!cell_sim/features/cache/manifest.json
!cell_sim/features/cache/.gitkeep
figures/output/
outputs/synthlet/.wt_*.pkl

# large local working model (reconstructed from Drive / the .gz; not committed)
outputs/orphan/cell_complete.json

# large local models fetched at runtime (not committed)
HumanGEM.xml
colab/HumanGEM.xml
HumanGEM_genes.tsv
colab/HumanGEM_genes.tsv
pdbs/
s669.csv
s2648.csv
outputs/orphan/dark_function_ckpt.json

# derived z-scored feature caches (built at runtime, persisted to Drive by persist.py — not committed)
# EXCEPT depmap_vecs.npz: every dense module loads it, and regenerating it needs the 400 MB
# CRISPRGeneEffect.csv. At 73 MB it is committed so a fresh clone (e.g. Colab) is self-sufficient.
# outputs/orphan/depmap_vecs.npz
outputs/orphan/expr_vecs.npz
outputs/orphan/tahoe_vecs.npz
outputs/orphan/pdb_cache/
data/hgnc.txt

# large regenerable reference chromosome (UCSC; refetch via colab/fetch_invivo.py)
outputs/orphan/invivo/*.fa
outputs/orphan/llm_reasoner_cache/
outputs/orphan/pdb_complexes/
data_fetch/

# ChIP-Atlas K562 peak sets (~190 MB) - regenerate with colab/fetch_chipatlas.py
outputs/orphan/invivo/chipatlas/

# GSE277502 bTMP-seq bigWigs (4.0 MB, re-fetchable from GEO; see colab/supercoil_track.py)
outputs/orphan/supercoil/*.bw

# RNADecayCafe v1.1 AvgKdegs (22 MB, re-fetchable: 10.5281/zenodo.16884513; see colab/supercoil_txn.py)
outputs/orphan/rnadecay/*.csv

# cell_complete.json stays ignored (38.5 MB, no producer), but its PARTS are versioned --
# colab/cell_complete_build.py --assemble reconstructs it bit-identically from outputs/orphan/cell_parts/
!outputs/orphan/cell_parts/

# UniProt raw stream: 90 MB, reproducible with `python colab/fetch_web.py` (G1).
# The derived per-gene table IS committed; the raw dump is not.
colab/data/uniprot_sites.tsv.gz
