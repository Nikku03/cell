 "magnitude_spearman_panel": 0.459,
 "mean_top10_hits_deployment": 2.02,
 "top10_STRONG_KOs (>=50 movers)": 9.0,
 "n_strong": 7,
 "top10_WEAK_KOs (<15 movers)": 0.81,
